MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=app-usage-monitoring
CORS_ORIGIN=http://localhost:5173
# Set to the deployed app URL in AWS, for example https://portal.example.com.
# VITE_API_BASE_URL is only needed when frontend and API use different origins.
VITE_API_BASE_URL=
# Local AI/LLM monitoring-agent API. In AWS set this to the agent's private service URL.
ASSISTANT_AGENT_URL=http://localhost:3002/api/assistant/chat
ASSISTANT_AGENT_TIMEOUT_MS=25000
# Shared private token between portal and agent, used in both directions
# (portal -> agent chat, agent -> portal MCP endpoints). Same value in both services.
MCP_SERVICE_TOKEN=replace-with-a-long-random-secret
RABBITMQ_URL=amqp://portal:portal_dev@localhost:5672/app_usage
RABBITMQ_TELEMETRY_EXCHANGE=tracker.telemetry
RABBITMQ_TELEMETRY_QUEUE=portal.telemetry.persist
RABBITMQ_PREFETCH=25
# Raw telemetry is deleted after this many days (0 keeps it forever).
TELEMETRY_RETENTION_DAYS=30
# Optional: required only when AWS SES email summaries are enabled.
# AWS_REGION=us-east-1
# SES_SOURCE_EMAIL=no-reply@example.com
# Comma-separated allow-list; the first address is the default recipient.
# SES_RECIPIENT_EMAIL=operations@example.com
