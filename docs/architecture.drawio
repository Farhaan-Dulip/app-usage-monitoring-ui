dth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#879196;" edge="1" parent="1" source="c19" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="logs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#879196;exitX=1;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="c16" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="140" y="150" width="30" height="30" as="geometry"/></mxCell><mxCell id="c40" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="30" height="30" as="geometry"/></mxCell><mxCell id="c41" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="960" y="175" width="30" height="30" as="geometry"/></mxCell><mxCell id="c42" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="590" y="760" width="30" height="30" as="geometry"/></mxCell><mxCell id="c43" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="140" y="450" width="30" height="30" as="geometry"/></mxCell><mxCell id="c44" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="960" y="450" width="30" height="30" as="geometry"/></mxCell><mxCell id="c45" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="410" y="860" width="30" height="30" as="geometry"/></mxCell><mxCell id="c46" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1210" y="380" width="30" height="30" as="geometry"/></mxCell><mxCell id="c47" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1210" y="150" width="30" height="30" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Request and data flows&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; Admin opens the portal over HTTPS; a CloudFront Function applies the IP allow-list.&lt;br&gt;&lt;b&gt;2&lt;/b&gt; CloudFront forwards privately (VPC origin) to the internal ALB, which routes to the portal and blocks /api/mcp/*.&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Portal and AI agent call each other over Service Connect with a shared service token.&lt;br&gt;&lt;b&gt;4&lt;/b&gt; All outbound traffic (Atlas, OpenAI) leaves through the NAT gateway's fixed IP.&lt;br&gt;&lt;b&gt;5&lt;/b&gt; Tracker laptops publish telemetry every 10 s over TLS through the NLB to RabbitMQ.&lt;br&gt;&lt;b&gt;6&lt;/b&gt; The telemetry worker consumes the queue; RabbitMQ data on EFS survives restarts.&lt;br&gt;&lt;b&gt;7&lt;/b&gt; Portal and worker read and write MongoDB Atlas; raw telemetry expires after 30 days.&lt;br&gt;&lt;b&gt;8&lt;/b&gt; ECS injects secrets from Secrets Manager at task start; logs go to CloudWatch.&lt;br&gt;&lt;b&gt;9&lt;/b&gt; cdk deploy builds the images, pushes them to ECR and rolls out new tasks." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;strokeColor=#D5DBDB;fillColor=#FAFAFA;spacing=10;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="850" y="880" width="610" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
