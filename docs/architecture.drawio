="1"><mxGeometry x="160" y="410" width="30" height="30" as="geometry"/></mxCell><mxCell id="c28" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="680" y="410" width="30" height="30" as="geometry"/></mxCell><mxCell id="c29" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="940" y="140" width="30" height="30" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Request and data flows&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; Admin opens the Amplify-hosted portal (shared username and password).&lt;br&gt;&lt;b&gt;2&lt;/b&gt; Amplify serves the UI and proxies /api/* to the portal Lambda function URL.&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Portal and AI agent call each other through function URLs with a shared service token.&lt;br&gt;&lt;b&gt;4&lt;/b&gt; The AI agent calls OpenAI.&lt;br&gt;&lt;b&gt;5&lt;/b&gt; The portal reads and writes DynamoDB (same server.js, DynamoDB adapter).&lt;br&gt;&lt;b&gt;6&lt;/b&gt; Tracker laptops POST telemetry over HTTPS with a bearer token.&lt;br&gt;&lt;b&gt;7&lt;/b&gt; The ingest function stores each sample once in DynamoDB.&lt;br&gt;&lt;b&gt;8&lt;/b&gt; Functions read secrets from SSM Parameter Store at cold start; nothing bills by the hour." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;strokeColor=#D5DBDB;fillColor=#FAFAFA;spacing=10;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="170" y="780" width="1030" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ecs-docker-deployment" name="ECS Docker deployment (UsagePoc, shut down)"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1120" math="0" shadow="0"><root><