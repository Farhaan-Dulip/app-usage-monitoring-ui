ght="64" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;MongoDB Atlas (M0)&lt;/b&gt;&lt;br&gt;allows the Elastic IP only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="830" width="180" height="52" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;OpenAI API&lt;/b&gt;&lt;br&gt;LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="830" width="150" height="52" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="HTTP :80 + secret header" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="Compose network + token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;startArrow=open;startFill=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="AMQPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#879196;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#879196;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#879196;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#879196;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="pull at boot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#879196;" edge="1" parent="1" source="c16" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="read at boot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#879196;" edge="1" parent="1" source="c17" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="awslogs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#879196;exitX=1;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="c14" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="140" y="210" width="30" height="30" as="geometry"/></mxCell><mxCell id="c35" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="440" y="220" width="30" height="30" as="geometry"/></mxCell><mxCell id="c36" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="790" y="225" width="30" height="30" as="geometry"/></mxCell><mxCell id="c37" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="140" y="450" width="30" height="30" as="geometry"/></mxCell><mxCell id="c38" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="790" y="445" width="30" height="30" as="geometry"/></mxCell><mxCell id="c39" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="610" y="800" width="30" height="30" as="geometry"/></mxCell><mxCell id="c40" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1140" y="380" width="30" height="30" as="geometry"/></mxCell><mxCell id="c41" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1140" y="150" width="30" height="30" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Request and data flows&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; Admin opens the portal over HTTPS; a CloudFront Function applies the IP allow-list and blocks /api/mcp/*.&lt;br&gt;&lt;b&gt;2&lt;/b&gt; CloudFront calls the instance on port 80 with a secret X-Origin-Verify header; the security group only admits CloudFront's addresses.&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Portal and AI agent call each other on the Docker Compose network with a shared service token.&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Tracker laptops publish telemetry every 10 s over TLS straight to RabbitMQ on the Elastic IP.&lt;br&gt;&lt;b&gt;5&lt;/b&gt; The telemetry worker consumes the queue and writes to MongoDB Atlas; raw telemetry expires after 30 days.&lt;br&gt;&lt;b&gt;6&lt;/b&gt; Outbound calls (Atlas, OpenAI) leave from the Elastic IP, which is on the Atlas allow-list.&lt;br&gt;&lt;b&gt;7&lt;/b&gt; At boot, start.sh reads secrets from Secrets Manager and passes them to the containers as environment variables.&lt;br&gt;&lt;b&gt;8&lt;/b&gt; cdk deploy builds the images, pushes them to ECR and replaces the instance; the Elastic IP moves to the new one." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;strokeColor=#D5DBDB;fillColor=#FAFAFA;spacing=10;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="170" y="910" width="1240" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="serverless-deployment" name="Serverless deployment (UsagePocServerless)"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="AWS Cloud (us-east-1)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="170" y="40" width="1030" height="620" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Admin browser&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="50" y="160" width="60" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Tracker laptops&lt;/b&gt;&lt;br&gt;HTTPS transport" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontS